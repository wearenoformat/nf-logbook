        "dob",
        "birth",
        "name",
        "login",
        "billing",
        "shipping",
        "remote_addr",
        "client_ip",
        "remote_ip",
        "/^ip$/",
        "/_ip$/",
        "/^comment_author/",
        "adminhash",
        "user_agent"
    ],
