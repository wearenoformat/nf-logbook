{
    "description": "Noformat Logger redaction test vectors (CONTRACT §2). Shared by the PHP plugin and the TypeScript port. Cases marked php_only use PHP serialization.",
    "algorithm": {
        "sensitive_key": "case-insensitive substring match of any pattern in sensitive_patterns (a pattern wrapped in /…/ is a regex); never sensitive: integer keys, keys in safe_keys (exact, case-insensitive), keys ending in _id, _ids, _hash or _count; patterns /^ip$/ and /_ip$/ are anchored so 'description', 'zip' or 'ip_scope' do not match",
        "marker": "{\"redacted\": true, \"sha256_8\": first 8 hex of HMAC-SHA256(salt, value)}; value: strings as-is, integers in decimal, true/false, null as \"\", arrays as canonical JSON (see hash-vectors.json)",
        "truncation": "strings longer than 2048 bytes become {\"truncated\": true, \"length\": <bytes>, \"sha256_8\": …}",
        "diff": "list of {field, old, new}; nested maps and lists recurse with dotted paths (field.key.0); a sensitive key at any level replaces both sides with markers; scalars compare as strings (10 == \"10\"), booleans strictly; max 100 changes, then one {\"field\":\"*\",\"old\":null,\"new\":{\"truncated\":true,\"omitted\":n}}",
        "username_hash": "first 32 hex of HMAC-SHA256(salt, \"username:\" + lowercase(trim(username)))",
        "value_scrub": "every string leaf that is not redacted (any key, any depth, also inside serialized values and diffs) has e-mail addresses replaced by \"[email]\" and IPv4/IPv6 addresses by \"[ip]\" before truncation (PHP Text::scrub())"
    },
    "salt": "fixture-salt-0123456789abcdef",
    "sensitive_patterns": [
        "email",
        "mail",
        "phone",
        "tel",
        "mobile",
        "fax",
        "address",
        "street",
