    "redact_value": [
        {
            "key": "user_email",
            "value": "jane@example.com",
            "expected": {
                "redacted": true,
                "sha256_8": "48761fc3"
            }
        },
        {
            "key": "post_title",
            "value": "Hello world",
            "expected": "Hello world"
        },
        {
            "key": "password",
            "value": null,
            "note": "null stays null",
            "expected": null
        },
        {
            "key": "settings",
            "value": {
                "color": "red",
                "smtp_password": "hunter2",
                "nested": {
                    "phone": "+31 6 1234",
                    "count": 3
                }
            },
            "note": "nested keys are redacted recursively",
            "expected": {
                "color": "red",
                "smtp_password": {
                    "redacted": true,
                    "sha256_8": "8431895d"
                },
                "nested": {
                    "phone": {
                        "redacted": true,
                        "sha256_8": "45bbb2b7"
                    },
                    "count": 3
                }
            }
        },
        {
            "key": "list",
            "value": [
                {
                    "email": "a@b.c"
                },
                {
                    "email": "d@e.f"
                }
            ],
            "expected": [
                {
                    "email": {
                        "redacted": true,
                        "sha256_8": "f391c9b3"
                    }
                },
                {
                    "email": {
                        "redacted": true,
                        "sha256_8": "e140a5e8"
                    }
                }
            ]
        },
        {
            "key": "body",
            "value_repeat": {
                "char": "a",
                "count": 3000
            },
            "note": "strings over 2048 bytes are truncated",
            "expected": {
                "truncated": true,
                "length": 3000,
                "sha256_8": "765e4b72"
            }
        },
        {
            "key": "exact_limit",
            "value_repeat": {
                "char": "b",
                "count": 2048
            },
            "note": "2048 bytes is kept",
            "expected_is_input": true
        },
        {
            "key": "note",
            "value": "Call jane@example.com from 192.168.1.20 or 2001:db8::7",
            "note": "e-mail and IP addresses are scrubbed under any key",
            "expected": "Call [email] from [ip] or [ip]"
        },
        {
            "key": "form",
            "value": {
                "message": "Reply to bob@example.org",
                "version": "6.4.1",
                "when": "12:30:45"
            },
            "note": "nested leaves are scrubbed; versions and times are kept",
            "expected": {
                "message": "Reply to [email]",
                "version": "6.4.1",
                "when": "12:30:45"
            }
        },
        {
            "key": "adminhash",
            "value": {
                "hash": "abc",
                "newemail": "x@y.z"
            },
            "note": "pending admin e-mail change (WordPress option adminhash) is redacted as a whole",
            "expected": {
                "redacted": true,
                "sha256_8": "b707769e"
            }
        }
    ],
    "diff": [
        {
            "name": "scalar",
            "field": "blogname",
            "old": "Old",
            "new": "New",
            "expected": [
                {
                    "field": "blogname",
                    "old": "Old",
                    "new": "New"
                }
            ]
        },
        {
            "name": "unchanged",
            "field": "blogname",
            "old": "Same",
            "new": "Same",
            "expected": []
        },
        {
            "name": "numeric_string_equals_int",
            "field": "posts_per_page",
            "old": "10",
            "new": 10,
            "expected": []
        },
        {
            "name": "nested_arrays_dotted_paths",
            "field": "theme_mods",
            "old": {
                "colors": {
                    "bg": "#fff",
                    "fg": "#000"
                },
                "logo": 5
            },
            "new": {
                "colors": {
                    "bg": "#eee",
                    "fg": "#000"
                },
                "header": true
            },
            "expected": [
                {
                    "field": "theme_mods.colors.bg",
                    "old": "#fff",
                    "new": "#eee"
                },
                {
                    "field": "theme_mods.logo",
                    "old": 5,
                    "new": null
                },
                {
                    "field": "theme_mods.header",
                    "old": null,
                    "new": true
                }
            ]
        },
        {
            "name": "list_by_index",
            "field": "sidebars",
            "old": [
                "a",
                "b"
            ],
            "new": [
                "a",
                "c",
                "d"
            ],
            "expected": [
                {
                    "field": "sidebars.1",
                    "old": "b",
                    "new": "c"
                },
                {
                    "field": "sidebars.2",
                    "old": null,
                    "new": "d"
                }
            ]
        },
        {
            "name": "sensitive_root_field",
            "field": "admin_email",
            "old": "old@example.com",
            "new": "new@example.com",
            "expected": [
                {
                    "field": "admin_email",
                    "old": {
                        "redacted": true,
                        "sha256_8": "d9efdae3"
                    },
                    "new": {
                        "redacted": true,
                        "sha256_8": "9ab5f60e"
                    }
                }
            ]
        },
        {
            "name": "sensitive_nested_field",
            "field": "woocommerce_settings",
            "old": {
                "api_key": "k1",
                "mode": "test"
            },
            "new": {
                "api_key": "k2",
                "mode": "live"
            },
            "expected": [
                {
                    "field": "woocommerce_settings.api_key",
                    "old": {
                        "redacted": true,
                        "sha256_8": "48dd3343"
                    },
                    "new": {
                        "redacted": true,
                        "sha256_8": "70e52576"
                    }
                },
                {
                    "field": "woocommerce_settings.mode",
                    "old": "test",
                    "new": "live"
                }
            ]
        },
        {
            "name": "serialized_php_arrays",
            "field": "widget_text",
            "old": "a:2:{s:5:\"title\";s:1:\"A\";s:5:\"count\";i:1;}",
            "new": "a:2:{s:5:\"title\";s:1:\"B\";s:5:\"count\";i:1;}",
            "php_only": true,
            "note": "PHP-serialized strings are unserialized (allowed_classes=false) before diffing",
            "expected": [
                {
                    "field": "widget_text.title",
                    "old": "A",
                    "new": "B"
                }
            ]
        },
        {
            "name": "serialized_object_not_instantiated",
            "field": "x",
            "old": "O:8:\"stdClass\":1:{s:1:\"a\";i:1;}",
            "new": "O:8:\"stdClass\":1:{s:1:\"a\";i:2;}",
            "php_only": true,
            "note": "objects become plain maps; __PHP_Incomplete_Class_Name becomes __class",
            "expected": [
                {
                    "field": "x.a",
                    "old": 1,
                    "new": 2
                }
            ]
        },
        {
            "name": "type_change_scalar_to_array",
            "field": "opt",
            "old": "x",
            "new": {
                "a": 1
            },
            "expected": [
                {
                    "field": "opt",
                    "old": "x",
                    "new": {
                        "a": 1
                    }
                }
            ]
        }
    ],
