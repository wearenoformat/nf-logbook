{
    "name": "noformat/nf-logbook",
    "description": "Tamper-evident, privacy-preserving activity, error and security log for WordPress, read by the Noformat Controlroom over a signed API.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        { "name": "Noformat", "email": "team@noformat.com" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "szepeviktor/phpstan-wordpress": "^1.3 || ^2.0",
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": { "Noformat\\Logger\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Noformat\\Logger\\Tests\\": "tests/unit/" }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": { "php": "8.1.99" },
        "sort-packages": true
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './.local/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    }
}
